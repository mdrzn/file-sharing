<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="generator" content="File Sharing <%= pkgVersion %>">
    <meta name="description" content="<%= SiteMetaInfo %>">
    <title><%= siteName %> &middot; Not found</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%236d5ae6'/%3E%3Cpath d='M16 23V10m0 0-5 5m5-5 5 5' stroke='white' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <link rel="stylesheet" href="https://<%= DOMAIN %>/file-sharing.min.css?v=20261111-ui">
</head>
<body>
<main class="page page-404">
    <section class="hero">
        <p class="code404">404</p>
        <h1>This file isn't here anymore.</h1>
        <p class="lead">Files are deleted after <%= expireTime %> <%= expireTimeUnit %>, or earlier if they break the rules. Maybe the link has a typo?</p>
        <p><a class="button" href="https://<%= DOMAIN %>/">Upload a file</a></p>
    </section>
</main>
</body>
</html>
